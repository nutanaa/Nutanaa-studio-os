{
  "extends": "./src/tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "types": ["@webgpu/types", "mocha", "semver", "sinon", "trusted-types", "winreg", "wicg-file-system-access"]
  },
  "include": ["src/vs/workbench/contrib/nutanaa/**/*.ts"]
}
